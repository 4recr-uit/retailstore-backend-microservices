# Retail Store - Phase 2 local service Compose settings
# Copy to .env, then run from the repository root, for example:
# docker compose --env-file .env -f src/cart/docker-compose.yml up --build
# docker compose --env-file .env -f src/recommendations/docker-compose.yml up --build
# docker compose --env-file .env -f src/app/docker-compose.yml -f src/app/compose.override.yaml up --build
# Pass --env-file explicitly so every included Compose file uses the same values.
# These settings configure src/*/docker-compose.yml; the legacy infrastructure-only
# docker-compose.local.yml is separate and will be consolidated in Phase 3.
# Compose maps service-prefixed settings to the runtime variables used by the code.
# *_PORT and *_DB_PORT publish host ports. Containers still listen on 8080,
# PostgreSQL on 5432 and MySQL on 3306. *_DB_CONNECTION_PORT is the port reached
# by an application inside the Docker network (or on an external database host).
# Existing database volumes retain their initialized users/passwords/databases;
# changing these settings does not migrate an already initialized database.

# Common defaults. Per-service passwords below inherit DB_PASSWORD unless changed.
DB_PASSWORD=test123
SEARCH_ENABLED=false

# Catalog (Go / MySQL-compatible database)
CATALOG_PORT=8081
CATALOG_DB_ENDPOINT=catalog-db:3306
RETAIL_CATALOG_PERSISTENCE_PROVIDER=mysql
MYSQL_DATABASE=catalogdb
MYSQL_USER=catalog_user
MYSQL_PASSWORD=${DB_PASSWORD}
MYSQL_ROOT_PASSWORD=${DB_PASSWORD}

# Cart (Go / PostgreSQL)
CART_PORT=8082
CART_DB_PORT=5433
CART_DB_HOST=carts-db
CART_DB_CONNECTION_PORT=5432
CART_DB_NAME=retaildb
CART_DB_USER=cart_user
CART_DB_PASSWORD=${DB_PASSWORD}
CART_DB_SSLMODE=disable
# Optional full connection string; takes precedence over CART_DB_* in the app.
CART_DATABASE_URL=
# For in-memory Cart, also leave CART_DB_HOST and CART_DATABASE_URL empty:
# the current Cart implementation selects PostgreSQL whenever either is set.
RETAIL_CART_PERSISTENCE_PROVIDER=postgres
CART_APP_MODE=api
CART_SQS_QUEUE_URL=

# Orders (Go / PostgreSQL)
ORDERS_PORT=8083
ORDERS_DB_PORT=5434
ORDERS_DB_HOST=orders-db
ORDERS_DB_CONNECTION_PORT=5432
ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=${DB_PASSWORD}
ORDERS_DB_SSLMODE=disable
ORDERS_DATABASE_URL=
RETAIL_ORDERS_PERSISTENCE_PROVIDER=postgres
ORDERS_APP_MODE=api
ORDERS_SQS_QUEUE_URL=

# Checkout (Python / PostgreSQL)
CHECKOUT_PORT=8085
CHECKOUT_DB_PORT=5435
CHECKOUT_DB_HOST=checkout-db
CHECKOUT_DB_CONNECTION_PORT=5432
CHECKOUT_DB_NAME=retaildb
CHECKOUT_DB_USER=checkout_user
CHECKOUT_DB_PASSWORD=${DB_PASSWORD}
CHECKOUT_DATABASE_URL=
RETAIL_CHECKOUT_PERSISTENCE_PROVIDER=postgres
CHECKOUT_APP_MODE=api
CHECKOUT_SQS_QUEUE_URL=
RETAIL_CHECKOUT_SHIPPING_NAME_PREFIX=

# Recommendations (Python / shares Catalog's database and seeded product tables)
# Its Compose file includes Catalog and waits for Catalog to finish starting.
RECOMMENDATIONS_PORT=8080
RETAIL_RECOMMENDATIONS_PERSISTENCE_PROVIDER=mysql
RECOMMENDATIONS_DB_ENDPOINT=${CATALOG_DB_ENDPOINT}
RECOMMENDATIONS_DB_NAME=${MYSQL_DATABASE}
RECOMMENDATIONS_DB_USER=${MYSQL_USER}
RECOMMENDATIONS_DB_PASSWORD=${MYSQL_PASSWORD}

# Optional SQS workers. API mode is the default and requires no LocalStack.
# To consume jobs, set the relevant *_APP_MODE to worker or all, and configure
# that service's *_SQS_QUEUE_URL plus the endpoint of an existing SQS service.
# This phase does not start LocalStack or create queues automatically.
# For example, when LocalStack is reachable in the same Docker network:
# AWS_ENDPOINT_URL=http://localstack:4566
# CART_SQS_QUEUE_URL=http://localstack:4566/000000000000/cart-queue
# ORDERS_SQS_QUEUE_URL=http://localstack:4566/000000000000/orders-queue
# CHECKOUT_SQS_QUEUE_URL=http://localstack:4566/000000000000/checkout-queue
# Test credentials are for local emulation; configure AWS credentials for AWS SQS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=
SQS_MAX_MESSAGES=1
SQS_WAIT_TIME_SECONDS=20
WORKER_CONCURRENCY=1
WORKER_DB_MODE=light

# UI (Java / on demand). Empty endpoints use the UI's built-in mocks when run
# alone. src/app/compose.override.yaml supplies backend endpoints for the demo.
# Nonempty values below override those demo endpoints as well.
UI_PORT=8888
RETAIL_UI_THEME=default
RETAIL_UI_SEARCH_ENABLED=${SEARCH_ENABLED}
RETAIL_UI_ENDPOINTS_CATALOG=
RETAIL_UI_ENDPOINTS_CARTS=
RETAIL_UI_ENDPOINTS_ORDERS=
RETAIL_UI_ENDPOINTS_CHECKOUT=
RETAIL_UI_ENDPOINTS_RECOMMENDATIONS=
