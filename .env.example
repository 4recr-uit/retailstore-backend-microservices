# ==============================================================================
# Retail Store Microservices - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.
# Example: cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Global / Common Settings
# ------------------------------------------------------------------------------
DB_PASSWORD=test123
SEARCH_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Catalog Service (Go / Gin + MySQL)
# ------------------------------------------------------------------------------
CATALOG_PORT=8081
RETAIL_CATALOG_PERSISTENCE_PROVIDER=mysql
MYSQL_DATABASE=catalogdb
MYSQL_USER=catalog_user
MYSQL_PASSWORD=test123
MYSQL_ROOT_PASSWORD=test123

# ------------------------------------------------------------------------------
# 3. Cart Service (Go / Gin + PostgreSQL)
# ------------------------------------------------------------------------------
CART_PORT=8082
CART_DB_PORT=5433
CART_DB_NAME=retaildb
CART_DB_USER=cart_user
CART_DB_PASSWORD=test123
RETAIL_CART_PERSISTENCE_PROVIDER=postgres
CART_APP_MODE=api

# ------------------------------------------------------------------------------
# 4. Orders Service (Go + PostgreSQL)
# ------------------------------------------------------------------------------
ORDERS_PORT=8083
ORDERS_DB_PORT=5434
ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=test123
RETAIL_ORDERS_PERSISTENCE_PROVIDER=postgres
ORDERS_APP_MODE=api

# ------------------------------------------------------------------------------
# 5. Checkout Service (Python / FastAPI + PostgreSQL)
# ------------------------------------------------------------------------------
CHECKOUT_PORT=8085
CHECKOUT_DB_PORT=5435
CHECKOUT_DB_NAME=retaildb
CHECKOUT_DB_USER=checkout_user
CHECKOUT_DB_PASSWORD=test123
RETAIL_CHECKOUT_PERSISTENCE_PROVIDER=postgres
CHECKOUT_APP_MODE=api
RETAIL_CHECKOUT_SHIPPING_NAME_PREFIX=

# ------------------------------------------------------------------------------
# 6. Recommendations Service (Python / FastAPI + MySQL)
# ------------------------------------------------------------------------------
RECOMMENDATIONS_PORT=8080
RETAIL_RECOMMENDATIONS_PERSISTENCE_PROVIDER=mysql
RECOMMENDATIONS_DB_NAME=catalogdb
RECOMMENDATIONS_DB_USER=catalog_user
RECOMMENDATIONS_DB_PASSWORD=test123

# ------------------------------------------------------------------------------
# 7. Optional: LocalStack / SQS (For Worker Mode & Async Queue Testing)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
LOCALSTACK_ENDPOINT=http://localstack:4566
SQS_MAX_MESSAGES=1
WORKER_CONCURRENCY=1
WORKER_DB_MODE=light

# ------------------------------------------------------------------------------
# 8. UI Service (Spring Boot - On Demand)
# ------------------------------------------------------------------------------
UI_PORT=8888
RETAIL_UI_THEME=default
RETAIL_UI_SEARCH_ENABLED=false
RETAIL_UI_ENDPOINTS_CATALOG=http://catalog:8080
RETAIL_UI_ENDPOINTS_CARTS=http://cart:8080
RETAIL_UI_ENDPOINTS_ORDERS=http://orders:8080
RETAIL_UI_ENDPOINTS_CHECKOUT=http://checkout:8080
RETAIL_UI_ENDPOINTS_RECOMMENDATIONS=http://recommendations:8080
