# Independent service configuration; no root .env is loaded.
# Copy to .env, replace placeholders, then export into the process environment
# or pass with docker run --env-file .env. The Go app does not load .env itself.
# These defaults target a MySQL server accessible from your development machine.
# Inside a container, replace localhost with a reachable hostname.
PORT=8080

# Persistence: mysql | in-memory
# Endpoint includes the port. On AWS, use the RDS MySQL hostname:3306.
RETAIL_CATALOG_PERSISTENCE_PROVIDER=mysql
RETAIL_CATALOG_PERSISTENCE_ENDPOINT=localhost:3306
RETAIL_CATALOG_PERSISTENCE_DB_NAME=catalogdb
RETAIL_CATALOG_PERSISTENCE_USER=catalog_app
RETAIL_CATALOG_PERSISTENCE_PASSWORD=replace-with-db-password
RETAIL_CATALOG_PERSISTENCE_CONNECT_TIMEOUT=5

# Optional search is disabled for the basic backend.
RETAIL_CATALOG_SEARCH_ENABLED=false
# RETAIL_CATALOG_SEARCH_PROVIDER=self-hosted
# RETAIL_CATALOG_SEARCH_OS_ENDPOINT=http://localhost:9200
# RETAIL_CATALOG_SEARCH_OS_INDEX=products
# RETAIL_CATALOG_SEARCH_OS_USERNAME=replace-with-search-user
# RETAIL_CATALOG_SEARCH_OS_PASSWORD=replace-with-search-password
# RETAIL_CATALOG_SEARCH_OS_TLS_SKIP_VERIFY=false

# Optional tracing: leave unset unless a collector is available.
# OTEL_SERVICE_NAME=catalog
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Database connection pool and startup retries.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONNECT_ATTEMPTS=6
DB_CONNECT_RETRY_SECONDS=5
# true uses verified TLS with the container's trusted CA certificates.
RETAIL_CATALOG_PERSISTENCE_TLS=false
HTTP_SHUTDOWN_TIMEOUT_SECONDS=5
