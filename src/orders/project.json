{
  "name": "orders",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src/orders",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "!{projectRoot}/dist/*"],
      "outputs": ["{projectRoot}/dist/*"],
      "options": {
        "command": "go build -o dist/main ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*"],
      "options": {
        "command": "go test -v -race ./..."
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*"],
      "options": {
        "command": "go test -v ./..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go vet ./..."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ."
      }
    },
    "manifest": {},
    "helm": {}
  },
  "tags": ["service", "chart"]
}
