# Independent service configuration; no root .env is loaded.
# Copy to .env, replace placeholders, then export into the process environment
# or pass with docker run --env-file .env. The Go app does not load .env itself.
# Inside a container, replace localhost with a reachable hostname.
PORT=8080
SERVICE_NAME=cart
# Supported modes in the current code: api | worker | all
APP_MODE=api

# PostgreSQL; the code currently uses the cart schema directly.
RETAIL_CART_PERSISTENCE_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retaildb
DB_USER=cart_app
DB_PASSWORD=replace-with-db-password
# disable is for local development. For RDS, use require or verify-full.
DB_SSLMODE=disable
# Optional CA file mounted at runtime when using verify-full.
DB_SSLROOTCERT=
# Optional: a non-empty DATABASE_URL overrides all DB_* connection settings.
# Encode reserved characters in the URL username/password.
# DATABASE_URL=postgres://cart_app:replace-with-db-password@localhost:5432/retaildb?sslmode=disable
# RDS example: add sslmode=verify-full&sslrootcert=/run/certs/rds-ca.pem
# and mount the actual CA file at that path.

# SQS: defaults below target LocalStack. Create the queue separately.
# For AWS, replace the URL with Terraform's cart queue URL and clear
# AWS_ENDPOINT_URL. Use EKS Pod Identity instead of static AWS credentials.
AWS_REGION=us-east-1
SQS_QUEUE_NAME=cart-queue
SQS_QUEUE_URL=http://localhost:4566/000000000000/cart-queue
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack only, if your SDK requires explicit dummy credentials:
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Worker settings; the same image can be launched with APP_MODE=worker.
WORKER_CONCURRENCY=1
SQS_MAX_MESSAGES=1
WORKER_DB_MODE=light

# Database connection settings (seconds unless stated otherwise).
DB_MAX_OPEN_CONNS=3
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# Worker networking and shutdown settings.
SQS_WAIT_TIME_SECONDS=20
SQS_REQUEST_TIMEOUT_SECONDS=5
WORKER_DB_TIMEOUT_SECONDS=10
WORKER_POLL_BACKOFF_SECONDS=1
WORKER_SHUTDOWN_TIMEOUT_SECONDS=10
HTTP_SHUTDOWN_TIMEOUT_SECONDS=5
