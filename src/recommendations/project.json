{
  "name": "recommendations",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src/recommendations",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "src/recommendations",
        "command": "python3 -m venv .venv && .venv/bin/pip install --quiet -r requirements.txt"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "python3 -m py_compile main.py test_main.py app/*.py"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": ".venv/bin/python -m unittest discover -v"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "options": {
        "command": ".venv/bin/python -m unittest discover -v"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "python3 -m py_compile main.py test_main.py app/*.py"
      }
    },
    "manifest": {},
    "helm": {}
  },
  "tags": ["service", "chart"]
}
