# Independent service configuration; no root .env is loaded.
# Copy to .env, replace placeholders, then export into the process environment
# or pass with docker run --env-file .env. Python does not load .env itself.
# Inside a container, replace localhost with a reachable hostname.
PORT=8080

# Persistence: mysql | in-memory
# Read the same catalogdb as catalog, using a separate read-only DB user.
# Endpoint includes the port. On AWS, use the RDS MySQL hostname:3306.
RETAIL_RECOMMENDATIONS_PERSISTENCE_PROVIDER=mysql
RETAIL_RECOMMENDATIONS_PERSISTENCE_ENDPOINT=localhost:3306
RETAIL_RECOMMENDATIONS_PERSISTENCE_DB_NAME=catalogdb
RETAIL_RECOMMENDATIONS_PERSISTENCE_USER=recommendations_reader
RETAIL_RECOMMENDATIONS_PERSISTENCE_PASSWORD=replace-with-db-password
RETAIL_RECOMMENDATIONS_PERSISTENCE_CONNECT_TIMEOUT=5

# SQLAlchemy connection pool.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
# For RDS, enable TLS. Optional CA file must be mounted at runtime.
RETAIL_RECOMMENDATIONS_PERSISTENCE_TLS=false
DB_SSL_CA=
