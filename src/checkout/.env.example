# Independent service configuration; no root .env is loaded.
# Copy to .env, replace placeholders, then export into the process environment
# or pass with docker run --env-file .env. Python does not load .env itself.
# Inside a container, replace localhost with a reachable hostname.
PORT=8080
# Supported modes in the current code: api | worker | all
APP_MODE=api

# PostgreSQL; the code currently uses the checkout schema directly.
RETAIL_CHECKOUT_PERSISTENCE_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retaildb
DB_USER=checkout_app
DB_PASSWORD=replace-with-db-password
# Optional: a non-empty DATABASE_URL overrides the connection fields above.
# Encode reserved characters in the URL username/password.
# DATABASE_URL=postgresql://checkout_app:replace-with-db-password@localhost:5432/retaildb?sslmode=disable
# These are used when DATABASE_URL is unset. For RDS, use require or
# verify-full and mount the CA file named by DB_SSLROOTCERT.
DB_SSLMODE=disable
DB_SSLROOTCERT=

# SQS: defaults below target LocalStack. Create the queue separately.
# For AWS, replace the URL with Terraform's checkout queue URL and clear
# AWS_ENDPOINT_URL. On EKS, credentials come from Pod Identity.
# AWS_DEFAULT_REGION remains supported as a fallback.
AWS_REGION=us-east-1
SQS_QUEUE_NAME=checkout-queue
SQS_QUEUE_URL=http://localhost:4566/000000000000/checkout-queue
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack only: uncomment both dummy credential values when needed.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

WORKER_CONCURRENCY=1
SQS_MAX_MESSAGES=1
SQS_WAIT_TIME_SECONDS=20
WORKER_DB_MODE=light

# Optional display prefix for the existing shipping options.
RETAIL_CHECKOUT_SHIPPING_NAME_PREFIX=

# Database connection and pool settings.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=30

# SDK HTTP connection pool and worker shutdown wait, in seconds.
SQS_MAX_POOL_CONNECTIONS=50
WORKER_SHUTDOWN_TIMEOUT_SECONDS=5
